# Copie para .env e preencha com valores reais. NUNCA commite o .env real.

NODE_ENV=development
PORT=3333

# Postgres (bate com o docker-compose.yml da raiz do projeto)
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk_saas?schema=public"

# Gere valores com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="troque-este-valor-em-producao"
JWT_REFRESH_SECRET="troque-este-outro-valor-em-producao"

# Cifra a chave de API de IA guardada no banco (AES-256-GCM). 32 bytes em hex.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY="troque-por-64-caracteres-hex-em-producao-0000000000000000000000"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Origem permitida para CORS (o endereço do seu frontend)
CORS_ORIGIN="http://localhost:5173"

# Rate limiting do login
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Bloqueio progressivo de conta após N tentativas falhas
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# Login social no "Criar conta" — todas opcionais. Sem elas o botão continua
# aparecendo, só devolve erro claro em vez de funcionar.
# BACKEND_URL="http://localhost:3333"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""
